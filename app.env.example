# Скопируйте параметры в app.env и укажите собственные значения.
TELEGRAM_TOKEN=
TELEGRAM_GROUPCHATID=
TELEGRAM_CHATID=
DB_NAME=./sqlite/data.db

# Обязательные данные для доступа к веб-интерфейсу администратора.
# Пароль должен содержать не менее 12 символов.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Адрес веб-сервера. По умолчанию только локальный компьютер.
WEB_ADDR=127.0.0.1:8090
# Для доступа по HTTPS укажите оба файла сертификата и ключа.
TLS_CERT_FILE=
TLS_KEY_FILE=
